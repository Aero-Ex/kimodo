# Kimodo Windows / low-VRAM fork configuration
# This file was added by Ayn1631 in 2026.

# True: force the local LLM2Vec text encoder to load on CPU.
# False: prefer MPS/CUDA when available.
CPU_Load=True

# Absolute path to the local Aero-Ex/KIMODO-Meta3_llm2vec_NF4 directory.
# Forward slashes are recommended on Windows.
LLM2Vec_dir=D:/path/to/kimodo/models/KIMODO-Meta3_llm2vec_NF4
